{
  "community": {
    "type": "object",
    "description": "社区资源安装",
    "items": {
      "github_accelerator_url": {"type": "string", "default": "https://ghfast.top/"}
    }
  },
  "semantic": {
    "type": "object",
    "description": "语义检索与图包语义化",
    "items": {
      "enabled": {"type": "bool", "default": false, "description": "启用语义检索"},
      "top_k": {"type": "int", "default": 5, "min": 1, "max": 20, "description": "候选数量"},
      "min_score": {"type": "float", "default": 0.25, "min": 0, "max": 1, "description": "最低相似度"},
      "vision_provider_id": {"type": "string", "default": "", "_special": "select_provider", "description": "语义视觉模型"},
      "embedding_provider_id": {"type": "string", "default": "", "_special": "select_provider_embedding", "description": "Embedding 模型"}
    }
  },
  "generation": {
    "type": "object",
    "description": "表情包生成与选取",
    "items": {
      "emotion": {
        "type": "object",
        "items": {
          "llm": {
            "type": "object",
            "items": {
              "enabled": {"type": "bool", "default": false, "description": "启用情感辅助选图"},
              "provider_id": {"type": "string", "default": "", "_special": "select_provider", "description": "情感辅助模型"},
              "context_turns": {"type": "int", "default": 0, "min": 0, "max": 20},
              "inject_persona": {"type": "bool", "default": false}
            }
          },
          "max_per_message": {"type": "int", "default": 2, "min": 1, "max": 6},
          "probability": {"type": "int", "default": 50, "min": 1, "max": 100},
          "strict_max_per_message": {"type": "bool", "default": true}
        }
      },
      "prompt": {
        "type": "object",
        "items": {
          "head": {"type": "text", "default": ""},
          "tail_before_limit": {"type": "text", "default": ""},
          "tail_after_limit": {"type": "text", "default": ""}
        }
      },
      "markup": {
        "type": "object",
        "items": {
          "enable_alternative": {"type": "bool", "default": true},
          "remove_invalid_alternative": {"type": "bool", "default": true},
          "enable_repeated_detection": {"type": "bool", "default": true}
        }
      },
      "matching": {
        "type": "object",
        "items": {
          "enable_loose_matching": {"type": "bool", "default": true},
          "high_confidence_emotions": {"type": "list", "items": {"type": "string"}, "default": []}
        }
      }
    }
  },
  "enabled": {"type": "bool", "default": true, "description": "启用群聊自动收集"},
  "group_whitelist": {"type": "list", "items": {"type": "string"}, "default": []},
  "vision_provider_id": {"type": "string", "default": "", "_special": "select_provider", "description": "收集识图模型"},
  "scene_provider_id": {"type": "string", "default": "", "_special": "select_provider", "description": "收集分类模型"},
  "only_capture_memes": {"type": "bool", "default": true},
  "fallback_category": {"type": "string", "default": "confused"},
  "max_images_per_message": {"type": "int", "default": 2, "min": 1, "max": 6},
  "max_image_size_mb": {"type": "int", "default": 10, "min": 1, "max": 50},
  "max_concurrent": {"type": "int", "default": 2, "min": 1, "max": 8},
  "download_timeout": {"type": "float", "default": 20, "min": 5, "max": 120},
  "health_check_interval": {"type": "float", "default": 300, "min": 10, "max": 600},
  "auto_send_enabled": {"type": "bool", "default": true},
  "auto_send_probability": {"type": "float", "default": 35, "min": 0, "max": 100},
  "auto_send_cooldown": {"type": "float", "default": 30, "min": 0, "max": 3600},
  "meme_follow_up_window": {"type": "float", "default": 300, "min": 10, "max": 1800},
  "library_index_provider_id": {"type": "string", "default": "", "_special": "select_provider"},
  "library_index_enabled": {"type": "bool", "default": false},
  "library_index_batch_size": {"type": "int", "default": 6, "min": 1, "max": 12},
  "library_index_progress_step": {"type": "int", "default": 5, "min": 1, "max": 50},
  "library_index_rename_files": {"type": "bool", "default": true},
  "perceptual_dedupe_enabled": {"type": "bool", "default": true},
  "perceptual_duplicate_threshold": {"type": "int", "default": 6, "min": 0, "max": 16},
  "meme_rejection_confidence": {"type": "float", "default": 0.7, "min": 0, "max": 1},
  "local_image_roots": {"type": "list", "items": {"type": "string"}, "default": []}
}
